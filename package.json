{
  "name": "tableflow-restaurant",
  "private": true,
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {"dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:api\" \"npm:dev:web\"", "dev:api": "npm --workspace apps/api run dev", "dev:web": "npm --workspace apps/web run dev", "build": "npm --workspace apps/web run build && npm --workspace apps/api run build", "db:generate": "npm --workspace apps/api run db:generate", "db:migrate": "npm --workspace apps/api run db:migrate"},
  "devDependencies": {"concurrently":"^9.1.2"}
}
