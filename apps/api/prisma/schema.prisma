
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}
enum OrderType {
  DINE_IN
  TAKEAWAY
}
enum PaymentMethod {
  COUNTER
  RAZORPAY
}
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
enum DiscountType {
  PERCENTAGE
  FIXED
}
model Admin {
  id        String   @id @default(cuid())
  name      String
  pinHash   String
  role      String   @default("ADMIN")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
model Customer {
  id             String         @id @default(cuid())
  name           String
  createdAt      DateTime       @default(now())
  orders         Order[]
  supportTickets SupportTicket[]
}
model Category {
  id         String    @id @default(cuid())
  name       String
  uniqueSlug String    @unique
  products   Product[]
  sortOrder  Int       @default(0)
  active     Boolean   @default(true)
}
model Product {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  imageUrl    String?
  isVeg       Boolean   @default(true)
  bestseller  Boolean   @default(false)
  available   Boolean   @default(true)
  taxRate     Decimal   @default(5) @db.Decimal(5, 2)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  variants    Variant[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
model Variant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  price     Decimal @db.Decimal(10, 2)
  imageUrl  String?
  available Boolean @default(true)
  @@index([productId])
}
model DiningTable {
  id       String  @id @default(cuid())
  label    String  @unique
  capacity Int     @default(2)
  active   Boolean @default(true)
}
model Coupon {
  id          String       @id @default(cuid())
  code        String       @unique
  type        DiscountType
  value       Decimal      @db.Decimal(10, 2)
  minOrder    Decimal      @default(0) @db.Decimal(10, 2)
  maxDiscount Decimal?     @db.Decimal(10, 2)
  usageLimit  Int?
  usedCount   Int          @default(0)
  expiresAt   DateTime?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  usages      CouponUsage[]
}
model Order {
  id                   String                @id @default(cuid())
  orderNumber          Int                   @unique @default(autoincrement())
  customerId           String
  customer             Customer              @relation(fields: [customerId], references: [id])
  customerName         String
  type                 OrderType
  tableLabel           String?
  status               OrderStatus           @default(PLACED)
  paymentMethod        PaymentMethod
  paymentStatus        PaymentStatus         @default(PENDING)
  subtotal             Decimal               @db.Decimal(10, 2)
  discount             Decimal               @default(0) @db.Decimal(10, 2)
  tax                  Decimal               @default(0) @db.Decimal(10, 2)
  total                Decimal               @db.Decimal(10, 2)
  couponCode           String?
  notes                String?
  items                OrderItem[]
  statusHistory        OrderStatusEvent[]
  cancellationRequests CancellationRequest[]
  supportTickets       SupportTicket[]
  payments             Payment[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  @@index([createdAt, status])
}
model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  variantId   String?
  productName String
  variantName String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(10, 2)
}
model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}
model Payment {
  id               String        @id @default(cuid())
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id])
  provider         String
  providerOrderId  String?
  providerPaymentId String?
  amount           Decimal       @db.Decimal(10, 2)
  status           PaymentStatus @default(PENDING)
  createdAt        DateTime      @default(now())
  @@unique([provider, providerPaymentId])
}
model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  orderId   String   @unique
  createdAt DateTime @default(now())
}
model CancellationRequest {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  reason    String
  status    String   @default("PENDING")
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model SupportTicket {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  orderId    String?
  order      Order?    @relation(fields: [orderId], references: [id])
  subject    String
  message    String
  status     String    @default("OPEN")
  reply      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
model RestaurantSettings {
  id        String  @id @default("default")
  name      String  @default("GRILL INN")
  address   String  @default("")
  phone     String  @default("")
  gstNumber String?
  currency  String  @default("INR")
}
model IntegrationSettings {
  id                          String   @id @default("default")
  razorpayKeyId               String?
  razorpaySecretEncrypted     String?
  razorpayTestMode            Boolean  @default(true)
  updatedAt                   DateTime @updatedAt
}
