# Supabase transaction pooler URL for the running API (port 6543; URL-encode password characters)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Supabase direct connection URL (or session pooler on port 5432) for Prisma migrations
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
PORT=4000
# Long random value; e.g. openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"
# 32 random bytes as 64 hex chars; used to AES-GCM encrypt API secrets stored in PostgreSQL.
INTEGRATION_ENCRYPTION_KEY="generate-64-hex-characters-and-store-only-on-the-server"
# Comma-separated allowed frontend origins
CLIENT_URL="http://localhost:5173,https://your-app.vercel.app"
# Only used once during initial seed, never checked into source control
INITIAL_ADMIN_PIN="set-a-private-pin"
# Optional dev-only demo login PIN. Ignored whenever NODE_ENV=production.
DEMO_ADMIN_PIN=""
# Optional Razorpay test/live credentials. Test with test keys before going live.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
